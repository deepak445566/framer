
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
   url      = env("DATABASE_URL")
}
enum Role {
  BUYER
  FARMER
  DRIVER
}

enum BidStatus{
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum OrderStatus{
  PENDING
  CONFIRMED
  DRIVER_ASSIGNED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum DeliveryStatus {
  PENDING
  ASSIGNED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  CANCELLED
}




model User{
  id Int @id @default(autoincrement())
  name String
  email String @unique
  password String
  role Role @default(BUYER)
  farmer Farmer?
  buyer Buyer?
  driver Driver?
  expense Expense[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
   @@index([role])
}
model Farmer{
  id Int @id @default(autoincrement())
  phone String
  village String
  district String
  state String
  cropTypes String[]
  profileImage String?
  coordinates Json
  userId Int @unique
  user User @relation(fields:[userId],references:[id])
  crops Crop[]
  orders Order[]
    conversations Conversation[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
   @@index([userId])
}
model Buyer{
  id Int @id @default(autoincrement())
  phone String
  village String
  district String
  state String
  profileImage String?
  coordinates Json
  bids Bid[]
  userId Int @unique
  user User @relation(fields:[userId],references:[id])
  orders Order[]
    conversations Conversation[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
   @@index([userId])
}

model Crop{
  id Int @id @default(autoincrement())
  title String
  description String
  category String
  quantity Float
  unit String
  pricePerUnit Float
  images String[]
  isAvailable Boolean @default(true)
  farmerId Int
  farmer Farmer @relation(fields:[farmerId],references:[id])
  bids Bid[]
  orders Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([farmerId])
  @@index([category])
  @@index([isAvailable])
}

model Bid{
  id Int @id @default(autoincrement())
  amount Float
  quantity Float
  message String?
  status BidStatus @default(PENDING)
  buyerId Int
  cropId Int
  order Order?
  buyer Buyer @relation(fields:[buyerId],references:[id])
  crop Crop @relation(fields:[cropId],references:[id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([buyerId])
  @@index([cropId])
  @@index([status])
}

model Order{
  id Int @id @default(autoincrement())
  quantity Float
  pricePerUnit Float
  totalAmount Float
  status OrderStatus @default(PENDING)
  buyerId Int
  farmerId Int
  cropId Int
  bidId Int? @unique
  delivery Delivery?
  buyer Buyer @relation(fields:[buyerId],references:[id])
  farmer Farmer @relation(fields:[farmerId],references:[id])
  crop Crop @relation(fields:[cropId],references:[id])
  bid Bid? @relation(fields:[bidId],references:[id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([buyerId])
  @@index([farmerId])
  @@index([status])
}

model Driver{
   id          Int      @id @default(autoincrement())
  phone       String
  vehicleNo   String
  vehicleType String
  isAvailable Boolean  @default(true)
userId Int @unique
  user   User @relation(fields: [userId], references: [id])
   coordinates Json
   deliveries Delivery[]
    createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
   @@index([userId])
}

model Delivery{
  id Int @id @default(autoincrement())
  orderId Int @unique
  order   Order @relation(fields: [orderId], references: [id])
  driverId Int?
  driver   Driver? @relation(fields: [driverId], references: [id])
pickupLocation  Json
  dropLocation    Json
   status DeliveryStatus @default(PENDING)

    createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([driverId])
  @@index([status])

}

model Expense{
  id Int @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id])
  title       String
  amount      Float
  category    String  
  description String?
  date DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Conversation {
  id Int @id @default(autoincrement())

  buyerId Int
  farmerId Int

  buyer Buyer @relation(fields:[buyerId],references:[id])
  farmer Farmer @relation(fields:[farmerId],references:[id])

  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([buyerId, farmerId])
}

model Message {
  id Int @id @default(autoincrement())

  conversationId Int
  senderId Int
  text String

  conversation Conversation @relation(fields:[conversationId],references:[id])

  createdAt DateTime @default(now())

  @@index([conversationId])
}

